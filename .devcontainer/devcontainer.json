{
  "name": "AgosAlert (Flutter)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },

  // Flutter web serves on 8080 by default (flutter run -d web-server --web-port 8080).
  // Codespaces auto-forwards it and gives you a clickable preview URL.
  "forwardPorts": [8080],

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/usr/local/flutter/bin"
  },

  // Installs the Flutter SDK straight from Google's repo, same way as a local install.
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y curl git unzip xz-utils zip libglu1-mesa && sudo git clone -b stable --depth 1 https://github.com/flutter/flutter.git /usr/local/flutter && sudo chown -R $(whoami) /usr/local/flutter",

  "postCreateCommand": "flutter doctor -v && flutter pub get"
}
